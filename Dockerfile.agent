FROM python:3.12-slim
WORKDIR /client
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python -m pip install --timeout 180 --retries 10 --disable-pip-version-check pip==26.2.1
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python -m pip install --timeout 180 --retries 10 --disable-pip-version-check --resume-retries 10 httpx==0.28.1
COPY demo/openai_agent.py /client/openai_agent.py
USER 10002:10002
ENTRYPOINT ["python", "/client/openai_agent.py"]
