# Set the analyst token in your PowerShell session to run the isolated demo.
# The gateway loads its separate credentials file, created by scripts/setup.py.
AGENTFENCE_TOKEN=replace-with-your-local-analyst-token
AGENTFENCE_URL=http://127.0.0.1:8000
# Optional live agent; configure locally, never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=

# Preferred provider: Gemini; use a free-tier project initially.
GEMINI_API_KEY=
GEMINI_MODEL=
