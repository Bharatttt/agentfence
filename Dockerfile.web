FROM python:3.12-slim AS base
WORKDIR /app
COPY requirements-runtime.txt .
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python -m pip install --timeout 180 --retries 10 --disable-pip-version-check pip==26.2.1
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked python -m pip install --timeout 180 --retries 10 --disable-pip-version-check --resume-retries 10 -r requirements-runtime.txt
ENV PYTHONDONTWRITEBYTECODE=1
USER 10002:10002
FROM base AS runner
COPY demo/openai_agent.py demo/gemini_agent.py demo/chat_runner.py ./demo/
CMD ["python", "-m", "uvicorn", "demo.chat_runner:create_app", "--factory", "--host", "0.0.0.0", "--port", "8002", "--no-access-log"]
FROM base AS portal
COPY portal ./portal
CMD ["python", "-m", "uvicorn", "portal.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]
